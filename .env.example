# ============================================================================
# MKT BATTISTON CRM - Example environment file
# ----------------------------------------------------------------------------
# Copy this file to backend/.env and fill in the values.
#   cp .env.example backend/.env
# NEVER commit your real backend/.env file.
# ============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Local development uses Docker Postgres on host port 5433 (see docker-compose.yml).
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# Full connection string used by the backend.
# Local (Docker db on host port 5433):
DATABASE_URL=postgres://crm:crm@localhost:5433/crm

# ---------------------------------------------------------------------------
# Backend server
# ---------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed frontend origins for CORS. Local default below.
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# WhatsApp / YCloud  (configured HERE by code/env, NOT from the app UI)
# ---------------------------------------------------------------------------
# API key from your YCloud account (used to SEND WhatsApp messages).
YCLOUD_API_KEY=
# Secret used to VERIFY the signature of incoming webhook requests.
# If this is empty, the webhook rejects every request with 401 (fail-closed).
YCLOUD_WEBHOOK_SECRET=
# Your WhatsApp sender number in E.164 format, e.g. +5493856456014
YCLOUD_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# AI model (OpenRouter)  -  FALLBACK ONLY
# ---------------------------------------------------------------------------
# The real AI config (API key + model) is set from the app's Agent screen.
# These values are only used as a fallback if nothing is configured in the UI.
OPENROUTER_API_KEY=
AGENT_MODEL=

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
# When true, the app seeds example data (company, meeting types, leads,
# conversations) the first time it runs against an empty database.
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Frontend (build-time)  -  set this in frontend/.env or as a build arg
# ---------------------------------------------------------------------------
# Public URL where the backend API is reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001
